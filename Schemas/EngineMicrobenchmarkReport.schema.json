{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hakkabon/Parser/Schemas/EngineMicrobenchmarkReport.schema.json",
  "title": "Parser engine microbenchmark report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "suite", "suiteFingerprint", "environment", "results", "fingerprintAlgorithm", "measurementFingerprint"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "parser-engine-microbenchmark-report" },
    "suite": { "$ref": "#/$defs/suite" },
    "suiteFingerprint": { "$ref": "#/$defs/fingerprint" },
    "environment": { "$ref": "#/$defs/environment" },
    "results": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/result" } },
    "fingerprintAlgorithm": { "const": "fnv1a64" },
    "measurementFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "owner", "engineID", "id", "title", "buildConfiguration", "warmupIterations", "measurementIterations", "cases"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "parser-engine-microbenchmark-suite" },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "version"],
          "properties": {
            "repository": { "type": "string", "minLength": 1, "maxLength": 128 },
            "version": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        "engineID": { "type": "string", "minLength": 1, "maxLength": 128 },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "buildConfiguration": { "enum": ["debug", "release"] },
        "warmupIterations": { "type": "integer", "minimum": 0, "maximum": 20 },
        "measurementIterations": { "type": "integer", "minimum": 3, "maximum": 100 },
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "operation", "boundary", "workloadFingerprint", "scale"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 128 },
              "title": { "type": "string", "minLength": 1, "maxLength": 256 },
              "operation": { "enum": ["construction", "recognition", "parsing", "forestConstruction"] },
              "boundary": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "workloadFingerprint": { "$ref": "#/$defs/fingerprint" },
              "comparisonGroup": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
              "scale": { "type": "integer", "minimum": 1, "maximum": 1000000000 }
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operatingSystem", "architecture", "processorCount", "physicalMemoryBytes"],
      "properties": {
        "operatingSystem": { "type": "string", "minLength": 1, "maxLength": 256 },
        "architecture": { "type": "string", "minLength": 1, "maxLength": 128 },
        "processorCount": { "type": "integer", "minimum": 1 },
        "physicalMemoryBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumNanoseconds", "medianNanoseconds", "percentile95Nanoseconds", "maximumNanoseconds"],
      "properties": {
        "minimumNanoseconds": { "type": "integer", "minimum": 1 },
        "medianNanoseconds": { "type": "integer", "minimum": 1 },
        "percentile95Nanoseconds": { "type": "integer", "minimum": 1 },
        "maximumNanoseconds": { "type": "integer", "minimum": 1 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseID", "evidenceFingerprint", "counters", "durationsNanoseconds", "timing"],
      "properties": {
        "caseID": { "type": "string", "minLength": 1, "maxLength": 128 },
        "evidenceFingerprint": { "$ref": "#/$defs/fingerprint" },
        "counters": { "type": "object", "maxProperties": 64, "propertyNames": { "minLength": 1, "maxLength": 128 }, "additionalProperties": { "type": "integer", "minimum": 0 } },
        "durationsNanoseconds": { "type": "array", "minItems": 3, "maxItems": 100, "items": { "type": "integer", "minimum": 1 } },
        "timing": { "$ref": "#/$defs/timing" }
      }
    }
  }
}
